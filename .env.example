# -------------------------------------------------------------
# 24/7 YouTube Live Streaming System - Environment Configuration
# -------------------------------------------------------------

# Server Configuration (Hugging Face default is 7860)
PORT=7860
HOST=0.0.0.0

# Multi-Stream Destinations (YouTube, Kick, Nimo TV & TikTok)
YOUTUBE_ENABLED=true
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
YOUTUBE_STREAM_KEY=YOUR_YOUTUBE_STREAM_KEY_HERE

KICK_ENABLED=true
KICK_RTMP_URL=rtmps://fa723fc1b171.global-contribute.live-video.net/app
KICK_STREAM_KEY=YOUR_KICK_STREAM_KEY_HERE

NIMO_ENABLED=false
NIMO_RTMP_URL=rtmp://alpush.rtmp.nimo.tv/live/
NIMO_STREAM_KEY=YOUR_NIMO_SIGNED_STREAM_KEY_HERE

TIKTOK_ENABLED=true
TIKTOK_RTMP_URL=rtmp://live-push.tiktok.com/live/
TIKTOK_STREAM_KEY=YOUR_TIKTOK_STREAM_KEY_HERE
# Optional TikTok LIVE Event URL or numeric event ID
TIKTOK_EVENT_ID=

# Video Source
# Can be a local filename (e.g. asd.video or videos/asd.video) or HTTP/HTTPS direct URL
VIDEO_SOURCE=video.mp4

# Stream Encoding Settings
STREAM_WIDTH=1920
STREAM_HEIGHT=1080
STREAM_FPS=30
STREAM_BITRATE=4500k
STREAM_AUDIO_BITRATE=160k
STREAM_PRESET=veryfast

# Loop & Auto-start Behavior
VIDEO_LOOP=true
AUTO_START=false

# Watchdog & Auto-Recovery
RECONNECT_ENABLED=true
RECONNECT_INITIAL_DELAY=5
RECONNECT_MAX_DELAY=60
RECONNECT_MAX_RETRIES=0

# Paths to binaries (defaults to system PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ─── Erişim Kontrol Sistemi (dost.md) ─────────────────────────────────────
# Resmi mobil uygulamanın gönderdiği gizli token (X-App-Token header'ı).
# Boş bırakılırsa native-app bypass devre dışı kalır (sadece mobil web aktif).
# Güçlü rastgele bir değer üretin: python -c "import secrets; print(secrets.token_urlsafe(40))"
APP_ACCESS_TOKEN=

# SQLite erişim veritabanı için HMAC pepper (boş bırakılırsa otomatik üretilir).
HFSTREAM_AUTH_SECRET=
